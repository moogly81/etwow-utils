#!/bin/bash
# --- Arduino local environment for ESP32-S3 ---

FQBN="esp32:esp32:xiao_esp32s3"   # Change si tu utilises une autre carte
PORT="/dev/cu.usbmodem2101"       # Vérifie le port avec `ls /dev/cu.*`





# 🔹 Répertoire courant du script
LOCAL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 🔹 Arduino CLI local
TOOLS_DIR="$LOCAL_DIR/tools/arduino-cli"
CLI_BIN="$TOOLS_DIR/arduino-cli"
CLI_CONF="$TOOLS_DIR/arduino-cli.yaml"

# --- Wrapper pour utiliser le CLI local ---
arduino-cli() {
  "$CLI_BIN" --config-file "$CLI_CONF" "$@"
}



# --- Raccourcis ---
compile() {
  arduino-cli compile --fqbn "$FQBN" "01_ble_calibration" "$@"
}

send() {
  arduino-cli upload -v -p "$PORT" --fqbn "$FQBN" "01_ble_calibration" "$@"
}

monitor() {
  arduino-cli monitor -p "$PORT" -c 115200
}

# --- Autocompletion locale pour zsh ---
if [ ! -f "$TOOLS_DIR/_arduino-cli" ]; then
  "$CLI_BIN" completion zsh > "$TOOLS_DIR/_arduino-cli"
fi

if [ -n "$ZSH_VERSION" ]; then
  fpath=("$TOOLS_DIR" $fpath)
  autoload -Uz compinit && compinit
  compdef _arduino-cli arduino-cli
fi

# 🔹 Feedback pour debug
echo "Arduino local environment loaded."
echo "FQBN=$FQBN, PORT=$PORT"
